; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="FirmoQuest"
config/version="0.5.0-beta.1"
; Pastreaza salvarile Windows din versiunile cu numele Business Simulator.
config/use_custom_user_dir.windows=true
config/custom_user_dir_name.windows="Godot/app_userdata/Business Simulator"
config/description="Joc economic educațional inspirat de condițiile economice ale Republicii Moldova."
run/main_scene="res://core/Main.tscn"
config/features=PackedStringArray("4.7", "C#")
config/icon="res://assets/ui/icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_mouse_from_touch=true

[dotnet]

project/assembly_name="BusinessSimulator"

[rendering]

environment/defaults/default_clear_color=Color(0.067, 0.082, 0.106, 1)
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
